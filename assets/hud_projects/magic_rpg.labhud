LABHUD_VERSION 1

# QA Magic RPG: Akademia Latajacych Miotel — HUD (RPG preset)
# Tylko sprawdzona skladnia Card/Label/Crosshair.
# Wiazania silnikowe: mission.name/cards/timer/status, player.health,
# weapon.name/clip. rpg.* = klucze Lua (pusto bez setHUDText) albo
# statyczny fallback przy pustym bindingu.

METADATA
    name "Magic RPG HUD"
    author "QA (10y exp)"
    resolution 1920 1080
END_METADATA

ASSETS
END_ASSETS

